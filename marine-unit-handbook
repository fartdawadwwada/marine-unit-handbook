    window.scrollTo(0,0);
    if(history.replaceState){ history.replaceState(null, '', '#' + id); }
  }
  links.forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      show(a.getAttribute('href').slice(1));
    });
  });
  var start = (location.hash || '#s0').slice(1);
  show(start);
})();
</script>

