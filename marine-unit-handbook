  <div class="tw">
    <table>
      <thead><tr><th></th><th>On the skyline</th><th>On the military crest</th></tr></thead>
      <tbody>
        <tr><td class="k">Silhouette</td><td>Full outline against open sky, visible for a long way</td><td>Rock or tree line behind you, outline breaks up</td></tr>
        <tr><td class="k">View down-slope</td><td>Full view, but so does everyone below</td><td>Same view, minus the exposure</td></tr>
